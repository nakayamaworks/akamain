PORT=8787
GOOGLE_WEB_CLIENT_ID=91251265328-erfa01b1c6gvnguh0f871t5t94om0ih0.apps.googleusercontent.com
GEMINI_API_KEY=replace-with-a-server-side-key
GEMINI_MODEL=gemini-3.5-flash-lite
ALLOWED_ORIGINS=http://localhost:5500

# memory: 開発確認用。プロセス終了で消える
# sheets: Google Sheetsへ永続化する
STORAGE_DRIVER=memory
GOOGLE_SHEETS_SPREADSHEET_ID=replace-with-a-spreadsheet-id

# ローカル開発でADCから保存専用サービスアカウントを偽装する場合だけ設定する。
# Cloud Runで同じサービスアカウントを直接割り当てる場合は不要。
GOOGLE_IMPERSONATE_SERVICE_ACCOUNT=typing-workbench-storage@example-project.iam.gserviceaccount.com

# JSON秘密鍵は作成・配置しない。ローカルはgcloud ADC、本番は実行サービスへ
# サービスアカウントを直接割り当てる。
