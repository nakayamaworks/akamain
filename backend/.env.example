PORT=8787
GOOGLE_WEB_CLIENT_ID=91251265328-erfa01b1c6gvnguh0f871t5t94om0ih0.apps.googleusercontent.com
FIREBASE_PROJECT_ID=typing-workbench-misemaru
GEMINI_API_KEY=replace-with-a-server-side-key
GEMINI_MODEL=gemini-3.5-flash-lite
ALLOWED_ORIGINS=http://localhost:5500

# memory: 開発確認用。プロセス終了で消える
# sheets: Google Sheetsへ永続化する
STORAGE_DRIVER=memory
GOOGLE_SHEETS_SPREADSHEET_ID=replace-with-a-spreadsheet-id

# 本番はfirestoreを使用し、複数Cloud RunインスタンスでAIレビュー上限を共有する。
# ローカルテストだけmemoryを使用できる。
RATE_LIMIT_DRIVER=memory
RATE_LIMIT_SALT=replace-with-a-random-server-side-value
SCORING_LIMIT_PER_MINUTE=5
SCORING_LIMIT_PER_USER_DAY=20
SCORING_LIMIT_PER_IP_DAY=40
SCORING_LIMIT_GLOBAL_DAY=500

# Firebaseで削除済みの匿名アカウントに紐づくデータを定期削除する。
ANONYMOUS_DATA_RETENTION_DAYS=31
ANONYMOUS_CLEANUP_BATCH_SIZE=100
CLEANUP_SERVICE_ACCOUNT_EMAIL=typing-workbench-cleanup@example-project.iam.gserviceaccount.com
CLEANUP_OIDC_AUDIENCE=https://typing-workbench-backend-example.run.app

# ローカル開発でADCから保存専用サービスアカウントを偽装する場合だけ設定する。
# Cloud Runで同じサービスアカウントを直接割り当てる場合は不要。
GOOGLE_IMPERSONATE_SERVICE_ACCOUNT=typing-workbench-storage@example-project.iam.gserviceaccount.com

# JSON秘密鍵は作成・配置しない。ローカルはgcloud ADC、本番は実行サービスへ
# サービスアカウントを直接割り当てる。
